---
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-slate-900 to-slate-800">
  <div class="absolute inset-0 opacity-20">
    <div class="absolute top-20 left-10 w-72 h-72 bg-amber-400 rounded-full blur-3xl animate-float"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 bg-rose-400 rounded-full blur-3xl animate-float" style="animation-delay: 1s;"></div>
  </div>

  <div class="container-custom relative z-10 py-24 px-4 pt-32 pb-10 md:pb-24">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="animate-on-scroll">
        <div class="inline-block px-4 py-2 bg-amber-400/10 border border-amber-400/30 rounded-full mb-6">
          <span class="text-amber-400 text-sm font-semibold">Where Lending Meets Education</span>
        </div>
        <h1 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl mb-6 leading-tight">
          Get Pre-Approved the <span class="gradient-text">Right Way</span>—Before You Waste Time, Money, or Energy House Hunting
        </h1>
        <p class="text-xl text-slate-300 mb-8 leading-relaxed">
          California's only mortgage broker who completely pre-underwrites your loan <strong class="text-amber-400">BEFORE</strong> you start shopping. No surprises. No stress. Just your custom journey to homeownership.
        </p>
        <a href="/contact" class="btn-primary inline-flex items-center gap-2 mb-8">
          Book Your Free 15-Minute Consultation
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
        <div class="grid md:grid-cols-3 gap-6 mt-12">
          <div class="flex items-start gap-3">
            <div class="flex-shrink-0 w-12 h-12 bg-amber-400/10 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-slate-100 mb-1">Know Exactly What You Qualify For</h3>
              <p class="text-sm text-slate-400">Complete pre-underwriting before you view your first home</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="flex-shrink-0 w-12 h-12 bg-amber-400/10 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-slate-100 mb-1">Understand Every Option</h3>
              <p class="text-sm text-slate-400">Learn to read itemized fee worksheets and choose what's truly best for you</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="flex-shrink-0 w-12 h-12 bg-amber-400/10 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-slate-100 mb-1">Skip the Usual Chaos</h3>
              <p class="text-sm text-slate-400">No last-minute surprises, no deals falling apart, no wasted inspections</p>
            </div>
          </div>
        </div>
      </div>
      <div class="relative animate-on-scroll">
        <div class="relative">
          <div class="absolute inset-0 bg-amber-400/20 blur-3xl rounded-full scale-110"></div>
          <img
            src="/images/placeholder-avatar.svg"
            alt="Joanna Perry, CEO & Senior Mortgage Broker"
            class="relative rounded-2xl shadow-2xl w-full max-w-lg mx-auto"
            width="500"
            height="500"
          />
          <div class="absolute bottom-6 left-6 bg-slate-900/90 backdrop-blur-sm border border-amber-400/50 rounded-xl p-4 shadow-xl">
            <p class="text-amber-400 font-semibold mb-1">15+ Years Experience</p>
            <p class="text-slate-300 text-sm">100% Referral-Based Business</p>
          </div>
        </div>
        <div class="mt-8 text-center">
          <p class="text-slate-400 text-sm mb-2">You're 15 minutes away from clarity</p>
          <div class="w-full bg-slate-700 rounded-full h-2 overflow-hidden">
            <div class="bg-gradient-to-r from-amber-400 to-rose-400 h-2 rounded-full w-[15%]"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</section>
