---
export interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="space-y-2" id="faq-accordion">
  {items.map((item, i) => (
    <div class="border border-slate-700 rounded-lg overflow-hidden bg-slate-800/50">
      <button
        type="button"
        class="faq-trigger w-full px-5 py-4 text-left flex items-center justify-between gap-4 text-slate-100 font-medium hover:bg-slate-800/50 transition-colors"
        aria-expanded="false"
        aria-controls={`faq-answer-${i}`}
        id={`faq-question-${i}`}
        data-index={i}
      >
        <span>{item.q}</span>
        <span class="faq-icon text-amber-400 text-xl flex-shrink-0">+</span>
      </button>
      <div
        id={`faq-answer-${i}`}
        role="region"
        aria-labelledby={`faq-question-${i}`}
        class="faq-answer hidden px-5 pb-4 text-slate-400"
      >
        {item.a}
      </div>
    </div>
  ))}
</div>

<script>
  document.querySelectorAll('.faq-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const wrapper = btn.closest('.border');
      const content = wrapper?.querySelector('.faq-answer');
      const icon = wrapper?.querySelector('.faq-icon');
      const isOpen = content?.classList.contains('hidden') === false;
      document.querySelectorAll('.faq-answer').forEach((el) => el.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach((el) => { el.textContent = '+'; });
      document.querySelectorAll('.faq-trigger').forEach((el) => el.setAttribute('aria-expanded', 'false'));
      if (!isOpen) {
        content?.classList.remove('hidden');
        icon && (icon.textContent = '−');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
