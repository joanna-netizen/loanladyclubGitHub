          <li><a href="/services/refinancing" class="text-slate-400 hover:text-amber-400 transition-colors">Refinancing</a></li>
          <li><a href="/services/va-loans" class="text-slate-400 hover:text-amber-400 transition-colors">VA Loans</a></li>
