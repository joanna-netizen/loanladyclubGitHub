          <li><a href="/testimonials" class="text-slate-400 hover:text-amber-400 transition-colors">Success Stories</a></li>
          <li><a href="/contact" class="text-slate-400 hover:text-amber-400 transition-colors">Contact</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-display font-semibold text-amber-400 mb-4">Services</h4>
