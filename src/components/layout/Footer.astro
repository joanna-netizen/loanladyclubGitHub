        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
          Survived 2008 Crash
        </span>
      </div>
    </div>
    <div class="border-t border-slate-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-slate-500">
      <p>© {currentYear} The Loan Lady Club. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="/privacy" class="hover:text-amber-400 transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-amber-400 transition-colors">Terms of Service</a>
