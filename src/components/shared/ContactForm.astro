---
export interface Props {
  formId?: string;
}
const { formId = 'YOUR_FORM_ID' } = Astro.props;
const formAction = `https://formspree.io/f/${formId}`;
---

<form action={formAction} method="POST" class="space-y-6">
  <div>
    <label for="name" class="block text-sm font-medium mb-2">Name *</label>
    <input
      type="text"
      id="name"
      name="name"
      required
      class="w-full px-4 py-3 bg-slate-800 border border-slate-700 rounded-lg focus:border-amber-400 focus:outline-none transition-colors text-slate-100"
    >
  </div>
  <div>
    <label for="email" class="block text-sm font-medium mb-2">Email *</label>
    <input
      type="email"
      id="email"
      name="email"
      required
      class="w-full px-4 py-3 bg-slate-800 border border-slate-700 rounded-lg focus:border-amber-400 focus:outline-none transition-colors text-slate-100"
    >
  </div>
  <div>
    <label for="phone" class="block text-sm font-medium mb-2">Phone *</label>
    <input
      type="tel"
      id="phone"
      name="phone"
      required
      class="w-full px-4 py-3 bg-slate-800 border border-slate-700 rounded-lg focus:border-amber-400 focus:outline-none transition-colors text-slate-100"
    >
  </div>
  <div>
    <label for="interest" class="block text-sm font-medium mb-2">I'm interested in *</label>
    <select
      id="interest"
      name="interest"
      required
      class="w-full px-4 py-3 bg-slate-800 border border-slate-700 rounded-lg focus:border-amber-400 focus:outline-none transition-colors text-slate-100"
    >
      <option value="">Select an option</option>
      <option value="first-time">First-time homebuying</option>
      <option value="refinance">Refinancing my current home</option>
      <option value="va-loan">VA loan</option>
      <option value="investment">Investment property</option>
      <option value="renovation">Renovation loan</option>
      <option value="denied">I was denied elsewhere</option>
      <option value="exploring">Just exploring options</option>
    </select>
  </div>
  <div>
    <label for="message" class="block text-sm font-medium mb-2">Tell me about your situation</label>
    <textarea
      id="message"
      name="message"
      rows="4"
      class="w-full px-4 py-3 bg-slate-800 border border-slate-700 rounded-lg focus:border-amber-400 focus:outline-none transition-colors text-slate-100"
    ></textarea>
  </div>
  <button type="submit" class="btn-primary w-full">Send My Message</button>
</form>
