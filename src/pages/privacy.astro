---
import Layout from '../components/layout/Layout.astro';
---

<Layout title="Privacy Policy" description="Privacy policy for The Loan Lady Club and joannaperry.com." canonical="/privacy">
  <section class="section-padding pt-32">
    <div class="container-custom max-w-3xl">
      <h1 class="text-4xl font-display font-bold mb-8">Privacy Policy</h1>
      <p class="text-slate-500 text-sm mb-8">Last updated: [Date]. Replace this with your full privacy policy.</p>
      <div class="prose prose-invert max-w-none space-y-4 text-slate-400">
        <p>We respect your privacy. This page will outline how we collect, use, and protect your information when you use our website and when you apply for or obtain a loan through us.</p>
        <p>Please replace this placeholder with your complete privacy policy, including: information we collect, how we use it, sharing with third parties, cookies, security, your rights, and contact information.</p>
      </div>
    </div>
  </section>
</Layout>
