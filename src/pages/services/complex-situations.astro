---
import Layout from '../../components/layout/Layout.astro';
---

<Layout title="Complex Situations - Denied Elsewhere? We Can Help" description="Denied by another lender? Self-employed? Complex income or credit? We find paths that other lenders miss." canonical="/services/complex-situations">
  <section class="section-padding pt-32">
    <div class="container-custom max-w-3xl">
      <h1 class="text-4xl font-display font-bold mb-6">Complex Situations</h1>
      <p class="text-slate-400 text-lg mb-8">Self-employed? Denied by a bank or two? Unusual income or credit history? Different lenders have different guidelines. We work with multiple investors and often find solutions when others say no.</p>
      <div class="card-dark mb-8">
        <h2 class="text-xl font-semibold text-amber-400 mb-4">Situations we handle</h2>
        <ul class="space-y-2 text-slate-400">
          <li>• Self-employment (full doc, bank statements, etc.)</li>
          <li>• Prior denials—we shop and find options</li>
          <li>• Credit challenges (we help you understand what to fix)</li>
          <li>• Non-warrantable condos, unique properties</li>
        </ul>
      </div>
      <a href="/contact" class="btn-primary">Book a Free Consultation</a>
    </div>
  </section>
</Layout>
