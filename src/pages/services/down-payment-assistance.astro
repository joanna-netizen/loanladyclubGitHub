---
import Layout from '../../components/layout/Layout.astro';
---

<Layout title="Down Payment Assistance - Grants & Programs" description="Explore down payment assistance and first-time buyer programs in California. We help you see what you qualify for." canonical="/services/down-payment-assistance">
  <section class="section-padding pt-32">
    <div class="container-custom max-w-3xl">
      <h1 class="text-4xl font-display font-bold mb-6">Down Payment Assistance</h1>
      <p class="text-slate-400 text-lg mb-8">There are grants and programs that can help with down payment and closing costs—especially for first-time buyers. We help you understand what's available in California and how it fits with your loan.</p>
      <div class="card-dark mb-8">
        <h2 class="text-xl font-semibold text-amber-400 mb-4">What we can help with</h2>
        <ul class="space-y-2 text-slate-400">
          <li>• State and local down payment assistance programs</li>
          <li>• Employer-assisted programs</li>
          <li>• How assistance pairs with FHA, conventional, and other loans</li>
        </ul>
      </div>
      <a href="/contact" class="btn-primary">Book a Free Consultation</a>
    </div>
  </section>
</Layout>
