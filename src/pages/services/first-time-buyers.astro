---
import Layout from '../../components/layout/Layout.astro';
---

<Layout title="First-Time Homebuyers - Programs & Guidance" description="First-time homebuyer programs in California. Down payment assistance, education, and pre-underwriting so you shop with confidence." canonical="/services/first-time-buyers">
  <section class="section-padding pt-32">
    <div class="container-custom max-w-3xl">
      <h1 class="text-4xl font-display font-bold mb-6">First-Time Homebuyers</h1>
      <p class="text-slate-400 text-lg mb-8">Buying your first home is a big step. We walk you through every part of the process—from credit and savings to loan programs and down payment assistance—so you know exactly what you qualify for before you start shopping.</p>
      <div class="card-dark mb-8">
        <h2 class="text-xl font-semibold text-amber-400 mb-4">What we offer</h2>
        <ul class="space-y-2 text-slate-400">
          <li>• Pre-underwriting so you know your true budget</li>
          <li>• Down payment assistance program guidance</li>
          <li>• First-time buyer loan programs (FHA, conventional, etc.)</li>
          <li>• Education on fees and options in plain English</li>
        </ul>
      </div>
      <a href="/contact" class="btn-primary">Book a Free Consultation</a>
    </div>
  </section>
</Layout>
