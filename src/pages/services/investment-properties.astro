---
import Layout from '../../components/layout/Layout.astro';
---

<Layout title="Investment Property Loans - Rentals and Flips" description="Finance investment properties in California. Rental properties, flips, and multi-unit. We shop rates and explain your options." canonical="/services/investment-properties">
  <section class="section-padding pt-32">
    <div class="container-custom max-w-3xl">
      <h1 class="text-4xl font-display font-bold mb-6">Investment Properties</h1>
      <p class="text-slate-400 text-lg mb-8">Financing for rental properties, flips, and multi-unit buildings is different from primary residence loans. We help you understand rates, terms, and requirements so you can grow your portfolio with confidence.</p>
      <div class="card-dark mb-8">
        <h2 class="text-xl font-semibold text-amber-400 mb-4">What we cover</h2>
        <ul class="space-y-2 text-slate-400">
          <li>• Rental property loans</li>
          <li>• Fix-and-flip and bridge financing</li>
          <li>• Multi-unit (2–4 units)</li>
        </ul>
      </div>
      <a href="/contact" class="btn-primary">Book a Free Consultation</a>
    </div>
  </section>
</Layout>
