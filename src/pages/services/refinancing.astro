---
import Layout from '../../components/layout/Layout.astro';
---

<Layout title="Refinancing - Lower Rate, Cash Out, or Shorter Term" description="Refinance your California home. Lower your rate, tap equity, or shorten your term. We explain your options clearly." canonical="/services/refinancing">
  <section class="section-padding pt-32">
    <div class="container-custom max-w-3xl">
      <h1 class="text-4xl font-display font-bold mb-6">Refinancing</h1>
      <p class="text-slate-400 text-lg mb-8">Whether you want to lower your rate, pull out cash for renovations or debt payoff, or shorten your term—we help you compare options and choose what makes sense for your situation.</p>
      <div class="card-dark mb-8">
        <h2 class="text-xl font-semibold text-amber-400 mb-4">Refinance options</h2>
        <ul class="space-y-2 text-slate-400">
          <li>• Rate-and-term refinance (lower payment or shorter term)</li>
          <li>• Cash-out refinance</li>
          <li>• VA IRRRL (streamline refinance for veterans)</li>
        </ul>
      </div>
      <a href="/contact" class="btn-primary">Book a Free Consultation</a>
    </div>
  </section>
</Layout>
