---
import Layout from '../../components/layout/Layout.astro';
---

<Layout title="Renovation Loans - Buy and Renovate in One Loan" description="California renovation loans: buy a fixer-upper and finance the repairs in one loan. FHA 203(k), HomeStyle, and more." canonical="/services/renovation-loans">
  <section class="section-padding pt-32">
    <div class="container-custom max-w-3xl">
      <h1 class="text-4xl font-display font-bold mb-6">Renovation Loans</h1>
      <p class="text-slate-400 text-lg mb-8">Want to buy a home that needs work? Renovation loans let you finance the purchase and the repairs in one loan so you can turn a fixer-upper into your dream home without a separate construction loan.</p>
      <div class="card-dark mb-8">
        <h2 class="text-xl font-semibold text-amber-400 mb-4">Programs we work with</h2>
        <ul class="space-y-2 text-slate-400">
          <li>• FHA 203(k)</li>
          <li>• HomeStyle Renovation</li>
          <li>• VA renovation options</li>
        </ul>
      </div>
      <a href="/contact" class="btn-primary">Book a Free Consultation</a>
    </div>
  </section>
</Layout>
