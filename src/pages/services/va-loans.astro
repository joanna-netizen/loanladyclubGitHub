---
import Layout from '../../components/layout/Layout.astro';
---

<Layout title="VA Loans - Zero Down for Veterans" description="VA home loans in California. Zero down, competitive rates, no PMI. We help veterans and active-duty families buy or refinance." canonical="/services/va-loans">
  <section class="section-padding pt-32">
    <div class="container-custom max-w-3xl">
      <h1 class="text-4xl font-display font-bold mb-6">VA Loans</h1>
      <p class="text-slate-400 text-lg mb-8">If you've served, you may qualify for a VA loan: zero down payment, no private mortgage insurance, and competitive rates. We help veterans and active-duty families buy or refinance across California.</p>
      <div class="card-dark mb-8">
        <h2 class="text-xl font-semibold text-amber-400 mb-4">VA loan benefits</h2>
        <ul class="space-y-2 text-slate-400">
          <li>• No down payment required</li>
          <li>• No PMI</li>
          <li>• Competitive interest rates</li>
          <li>• VA IRRRL for streamline refinance</li>
        </ul>
      </div>
      <a href="/contact" class="btn-primary">Book a Free Consultation</a>
    </div>
  </section>
</Layout>
