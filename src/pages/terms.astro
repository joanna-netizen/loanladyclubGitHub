---
import Layout from '../components/layout/Layout.astro';
---

<Layout title="Terms of Service" description="Terms of service for The Loan Lady Club website." canonical="/terms">
  <section class="section-padding pt-32">
    <div class="container-custom max-w-3xl">
      <h1 class="text-4xl font-display font-bold mb-8">Terms of Service</h1>
      <p class="text-slate-500 text-sm mb-8">Last updated: [Date]. Replace this with your full terms of service.</p>
      <div class="prose prose-invert max-w-none space-y-4 text-slate-400">
        <p>By using this website, you agree to these terms. This is a placeholder. Please replace with your complete terms of service, including use of the site, disclaimers, limitation of liability, and governing law.</p>
      </div>
    </div>
  </section>
</Layout>
